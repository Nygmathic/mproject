{{- $articles := where site.RegularPages "Section" "in" (slice "opinion" "lifestyle" "politics" "business" "sports" "climate" "technology" "africa" "science" "culture") -}}
{{- $items := slice -}}
{{- range $articles -}}
  {{- $items = $items | append (dict
    "title" .Title
    "url" .Permalink
    "author" (.Params.author | default site.Params.author)
    "summary" (.Description | default .Summary | plainify | truncate 220)
    "content" (.Plain | truncate 600)
    "section" (replace .Section "-" " " | title)
    "date" (.Date.Format "2006-01-02")
    "readingTime" .ReadingTime
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
