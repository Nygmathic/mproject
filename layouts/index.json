{{- /*
  Search Index Generator
  Generates JSON file with all articles for Fuse.js search
  Place this in: layouts/index.json
*/ -}}
{{- $pages := where .Site.Pages "Kind" "page" -}}
{{- $validSections := slice "news" "opinion" "lifestyle" "politics" "sports" "africa" "business" "climate" "law" "curious" "global-affairs" -}}
[
  {{- $first := true -}}
  {{- range $page := $pages -}}
    {{- if and (ne $page.Title "") (in $validSections $page.Section) -}}
      {{- if not $first }},{{ end -}}
      {{- $first = false }}
      {
        "title": {{ $page.Title | jsonify }},
        "url": {{ $page.Permalink | jsonify }},
        "content": {{ $page.Plain | truncate 2000 | jsonify }},
        "summary": {{ $page.Summary | jsonify }},
        "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
        "readingTime": {{ $page.ReadingTime }},
        "section": {{ $page.Section | jsonify }},
        "categories": [{{ range $i, $cat := $page.Params.categories }}{{ if $i }},{{ end }}{{ $cat | jsonify }}{{ end }}]
      }
    {{- end -}}
  {{- end }}
]