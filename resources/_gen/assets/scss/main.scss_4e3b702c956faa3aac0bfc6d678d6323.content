*{box-sizing:border-box}body{margin:0;padding:0;background-color:#fdfdfd;color:#1a1a1a;font-family:"Helvetica Neue","Arial",sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}h1,h2,h3,.serif-text{font-family:"Lyon Display","Georgia",serif;font-weight:400;margin-top:0}a{color:inherit;text-decoration:none;transition:opacity 0.2s ease}a:hover{opacity:0.7}.site-layout{display:grid;grid-template-columns:[full-start] minmax(1.5rem, 1fr) [main-start] minmax(0, 1100px) [main-end] minmax(1.5rem, 1fr) [full-end]}.site-layout>*{grid-column:main}.site-layout .full-bleed{grid-column:full}.container{padding:3rem 0}.site-header{border-bottom:1px solid #1a1a1a;padding:1.5rem 0}.site-header .header-container{display:flex;justify-content:space-between;align-items:baseline}.site-header .logo{font-family:"Lyon Display","Georgia",serif;font-size:1.8rem;font-weight:bold;text-transform:uppercase;letter-spacing:-1px}.site-header .nav-list{list-style:none;display:flex;gap:2rem;margin:0;padding:0;font-size:0.9rem;text-transform:uppercase;font-weight:600;letter-spacing:0.05em}.site-header .nav-list .active{border-bottom:2px solid #1a1a1a}.article-longform{max-width:720px;margin:0 auto;padding:4rem 0}.article-longform header{margin-bottom:3rem;text-align:center}.article-longform header .entry-title{font-size:clamp(2.5rem, 6vw, 4.5rem);line-height:1.1;margin-bottom:1rem}.article-longform header .entry-summary{font-size:1.4rem;color:#555;font-style:italic}.article-longform .article-content{font-family:"Lyon Display","Georgia",serif;font-size:1.2rem}.article-longform .article-content p{margin-bottom:2rem}.article-longform .article-content img{width:100%;height:auto;margin:2rem 0}.hp-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));gap:2.5rem}.hp-grid .card{border-top:1px solid #1a1a1a;padding-top:1rem}.hp-grid .card .card-cat{font-size:0.75rem;text-transform:uppercase;font-weight:bold;color:#c00}.hp-grid .card .card-title{font-size:1.5rem;margin:0.5rem 0;line-height:1.2}.skip-link{position:absolute;top:-40px;left:0;background:#1a1a1a;color:white;padding:8px;z-index:100}.skip-link:focus{top:0}@media (max-width: 768px){.site-header .nav-list{display:none}}
